# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=apex_db

# Backend
PORT=3001
# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGINS=http://localhost:3000

# Autenticación (JWT). Genera un secreto largo y aleatorio para producción.
JWT_SECRET=cambiar_este_secreto_en_produccion
JWT_EXPIRES_IN=8h

# Contraseña asignada a los usuarios creados por el seed (solo desarrollo).
SEED_DEFAULT_PASSWORD=Apex2026!

# Almacenamiento de objetos (Cloudflare R2, API compatible con S3).
# Sin estas variables la subida de archivos queda deshabilitada.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=apex-media
# Dominio público del bucket, sin barra final (r2.dev o tu dominio propio).
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api
